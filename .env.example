# ── LINE Messaging API ──────────────────────────────────────
# GO本人向け窓口(将来分離する場合はSTAFF側も別チャンネルを用意する)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# GO本人のLINE userId(フル権限)。Webhookログや公式アカウントの友だち追加イベントで確認する。
GO_LINE_USER_ID=

# スタッフのLINE userIdをカンマ区切りで列挙(窓口モード・伝言取次のみ)
STAFF_LINE_USER_IDS=

# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── Google OAuth2 (Calendar + YouTube 共通) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 例: https://<your-vercel-domain>/api/oauth/google/callback
GOOGLE_REDIRECT_URI=
# YouTubeチャンネルのCalendar ID。個人カレンダーなら "primary" でよい。
GOOGLE_CALENDAR_ID=primary

# 初回ブラウザ認証後にVercel KVへ自動保存されるが、
# 手元で確認・再設定したい場合はここに直接refresh_tokenを置くことも可能(任意)
GOOGLE_REFRESH_TOKEN=

# ── Gmail監視(YouTube案件メール通知)用。上のGoogle OAuthとは別アカウントを認証する ──
# 例: https://<your-vercel-domain>/api/oauth/gmail/callback
GOOGLE_GMAIL_REDIRECT_URI=

# ── 天気情報(気象庁API) ─────────────────────────────────────
# 宮城県の予報区コード(仙台管区気象台) / 変更不要
JMA_OFFICE_CODE=040000
JMA_AREA_CODE=040010
JMA_AMEDAS_CODE=34392

# ── Vercel KV(Vercelダッシュボードで作成すると自動的に注入される) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Cron保護用シークレット(Vercel Cronからのリクエストのみ許可) ──
CRON_SECRET=
